{
    "name": "fdxse/muninn-api",
    "description": "Muninn REST-style JSON API (PHP 8.2+, MariaDB).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Muninn\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Muninn\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src public bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
