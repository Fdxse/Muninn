# Muninn help pages: plain static HTML. The app's pages get their security headers from PHP
# (includes/page.php); these files are not PHP, so Apache sends similar headers here instead.
# The help pages only load files from this site and never call the API.
DirectoryIndex index.html
<IfModule mod_headers.c>
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer"
    Header set X-Frame-Options "DENY"
</IfModule>
