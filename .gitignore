# Real configuration files hold credentials and are never committed.
api/config/config.php
api/public/app-location.php
frontend/public/includes/config.php
.env

# Runtime data (logs, attachments) lives outside the repository on servers.
api/storage/*
!api/storage/.gitkeep

# Dependencies and tool caches.
api/vendor/
api/.phpunit.cache/

# Build output of the release workflow.
build/

# Editor/OS noise.
.idea/
.vscode/
.DS_Store
Thumbs.db
